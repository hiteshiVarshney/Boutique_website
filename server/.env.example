# MongoDB connection string
# Local MongoDB:  mongodb://127.0.0.1:27017/maison_elegance
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/maison_elegance
MONGO_URI=mongodb://127.0.0.1:27017/maison_elegance

# Port the Express server listens on
PORT=5001

# ---- Admin Authentication ----
# Generate these values by running:  node server/scripts/create-admin.js
# Never commit your actual server/.env with real secrets.

# Admin username (choose your own — do not use "admin")
ADMIN_USERNAME=

# Bcrypt hash of the admin password (output from create-admin.js)
ADMIN_PASSWORD_HASH=

# Secret used to sign JWT auth tokens (output from create-admin.js)
JWT_SECRET=

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Set to "production" when deploying to enable Secure cookies and SameSite=none
# NODE_ENV=production
